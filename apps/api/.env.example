# Runtime
ATS_ENVIRONMENT=local
ATS_DEBUG=false
ATS_APP_VERSION=0.1.0

# Shared API key. Leave empty for local development.
# When set, send it as `X-API-Key` (or `?api_key=` for SSE).
ATS_API_KEY=
# Optional per-user API keys, "email=key,email2=key2". When set it takes
# precedence over ATS_API_KEY and each key resolves to its own user row.
# This is a lightweight ownership boundary, not SSO.
ATS_API_KEYS=

# Comma-separated origins allowed to call the API from a browser.
ATS_ALLOWED_ORIGINS=http://localhost:3000

# Database: SQLite for local dev, PostgreSQL in production.
ATS_DATABASE_URL=sqlite+aiosqlite:///./ats.db
# Use Alembic in production instead of create_all.
ATS_AUTO_CREATE_TABLES=true

# Storage
ATS_STORAGE_BACKEND=local
ATS_STORAGE_DIR=./.data/uploads
ATS_MAX_UPLOAD_BYTES=10485760
ATS_MAX_JD_CHARS=60000

# LLM: stub keeps scoring and proposals deterministic and offline.
# Set to openai or anthropic plus a key to enable LLM rewriting.
ATS_LLM_PROVIDER=stub
ATS_LLM_MODEL=gpt-4o-mini
ATS_LLM_API_KEY=
ATS_LLM_BASE_URL=
ATS_LLM_TIMEOUT_SECONDS=45
ATS_LLM_MAX_OUTPUT_TOKENS=2000
ATS_LLM_MAX_RETRIES=2
ATS_LLM_RETRY_BACKOFF_SECONDS=0.5
# Cost estimates per million tokens. Set these to your provider's prices.
ATS_LLM_INPUT_COST_PER_MILLION=0
ATS_LLM_OUTPUT_COST_PER_MILLION=0
ATS_LLM_TRACE_ENABLED=true
# Schema-validated LLM structuring and the optional bounded judge.
ATS_LLM_STRUCTURING_ENABLED=false
ATS_LLM_JUDGE_ENABLED=false
ATS_LLM_JUDGE_BLEND_WEIGHT=0
ATS_PROMPT_VERSION=rewriter-v1

# Phase 2 AI/NLP. Hashed embeddings are the deterministic default.
ATS_EMBEDDING_PROVIDER=hashed
ATS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ATS_EMBEDDING_CACHE_SIZE=4096
ATS_EMBEDDING_STORE_ENABLED=true
# json works everywhere; pgvector needs PostgreSQL + the Phase 2 migration.
ATS_EMBEDDING_STORE_BACKEND=json
# Set to the trained model's dimension (384 for bge-small) before the migration.
ATS_EMBEDDING_VECTOR_DIM=512
# ATS_SEMANTIC_LOW=0.12
# ATS_SEMANTIC_HIGH=0.42
ATS_RERANKER_ENABLED=false
ATS_RERANKER_MODEL=BAAI/bge-reranker-base
ATS_RERANKER_WEIGHT=0.5
ATS_BM25_WEIGHT=0
ATS_FUZZY_MATCHING_ENABLED=true
ATS_FUZZY_THRESHOLD=88
ATS_SPACY_ENABLED=false
ATS_SPACY_MODEL=en_core_web_sm

# External taxonomy files (comma-separated JSON/CSV/JSONL paths).
ATS_TAXONOMY_PATHS=
ATS_TAXONOMY_VERSION=curated-v1

# JD analysis cache. Use redis + ATS_REDIS_URL for multi-worker deployments.
ATS_JD_CACHE_BACKEND=memory
ATS_REDIS_URL=
ATS_JD_CACHE_TTL_SECONDS=3600
ATS_JD_CACHE_MAX_ENTRIES=512

# Calibration, fairness, and multi-JD previews.
ATS_CALIBRATION_ENABLED=false
ATS_CALIBRATION_PATH=
ATS_CALIBRATION_BLEND_WEIGHT=0
ATS_FAIRNESS_REDACTION_ENABLED=true
ATS_MULTI_JD_MAX_TARGETS=5

# Scoring overrides (JSON). Defaults match the architecture doc §4.3.
# ATS_SCORING_WEIGHTS={"keyword_match":0.30,"semantic_relevance":0.20,"experience_fit":0.15,"parseability":0.15,"impact":0.10,"education":0.05,"readability":0.05}
ATS_MUST_HAVE_CAP=70
ATS_PARSE_FIDELITY_CAP=60
ATS_PARSE_FIDELITY_FLOOR=60
ATS_KEYWORD_STUFFING_PENALTY=12

# Optimiser
ATS_OPTIMISER_MAX_ITERATIONS=3
ATS_OPTIMISER_TARGET_SCORE=85
ATS_OPTIMISER_MAX_CHANGES=25

# Phase 2 LaTeX pipeline. Compilation is opt-in and falls back to static
# analysis when disabled or when no worker/engine is available.
# Engine: auto (HTTP worker -> Docker -> local in dev/test), docker, or local.
ATS_LATEX_COMPILE_ENABLED=false
ATS_LATEX_COMPILE_ENGINE=auto
# Optional long-lived worker, e.g. http://localhost:8099. When unset, the API
# tries a one-shot Docker container, then a local Tectonic/latexmk/pdflatex.
ATS_LATEX_WORKER_URL=
ATS_LATEX_WORKER_IMAGE=ats-latex-worker:latest
ATS_LATEX_COMPILE_TIMEOUT_SECONDS=60
ATS_LATEX_MAX_OUTPUT_BYTES=20971520

# Optional OCR fallback for scanned/image PDFs. Requires Tesseract plus the
# API's `ocr` extra (PyMuPDF, pytesseract, Pillow).
ATS_OCR_ENABLED=false

# Retention: null keeps data until the user deletes it. POST /v1/account/purge
# applies this window; DELETE /v1/account removes everything immediately.
ATS_RETENTION_DAYS=

# In-process per-identity rate limits. 0 disables a limit. A multi-worker
# deployment still needs a shared limiter (Redis or the API gateway).
ATS_RATE_LIMIT_REQUESTS_PER_MINUTE=180
ATS_RATE_LIMIT_UPLOADS_PER_MINUTE=20
ATS_RATE_LIMIT_OPTIMISE_JOBS_PER_HOUR=30
