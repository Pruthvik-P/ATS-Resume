# Runtime
ATS_ENVIRONMENT=local
ATS_DEBUG=false
ATS_APP_VERSION=0.1.0

# Shared API key. Leave empty for local development.
# When set, send it as `X-API-Key` (or `?api_key=` for SSE).
ATS_API_KEY=

# Comma-separated origins allowed to call the API from a browser.
ATS_ALLOWED_ORIGINS=http://localhost:3000

# Database: SQLite for local dev, PostgreSQL in production.
ATS_DATABASE_URL=sqlite+aiosqlite:///./ats.db
# Use Alembic in production instead of create_all.
ATS_AUTO_CREATE_TABLES=true

# Storage
ATS_STORAGE_BACKEND=local
ATS_STORAGE_DIR=./.data/uploads
ATS_MAX_UPLOAD_BYTES=10485760
ATS_MAX_JD_CHARS=60000

# LLM: stub keeps scoring and proposals deterministic and offline.
# Set to openai or anthropic plus a key to enable LLM rewriting.
ATS_LLM_PROVIDER=stub
ATS_LLM_MODEL=gpt-4o-mini
ATS_LLM_API_KEY=
ATS_LLM_BASE_URL=
ATS_LLM_TIMEOUT_SECONDS=45

# Scoring overrides (JSON). Defaults match the architecture doc §4.3.
# ATS_SCORING_WEIGHTS={"keyword_match":0.30,"semantic_relevance":0.20,"experience_fit":0.15,"parseability":0.15,"impact":0.10,"education":0.05,"readability":0.05}
ATS_MUST_HAVE_CAP=70
ATS_PARSE_FIDELITY_CAP=60
ATS_PARSE_FIDELITY_FLOOR=60
ATS_KEYWORD_STUFFING_PENALTY=12

# Optimiser
ATS_OPTIMISER_MAX_ITERATIONS=3
ATS_OPTIMISER_TARGET_SCORE=85
ATS_OPTIMISER_MAX_CHANGES=25
