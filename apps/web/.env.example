# Base URL of the FastAPI engine, as seen from the Next.js server.
# Prefer 127.0.0.1 over localhost to avoid IPv6 resolution surprises.
API_BASE_URL=http://127.0.0.1:8000

# Optional. Must match ATS_API_KEY on the FastAPI engine.
# Leave blank when the engine runs in local mode with no API key.
ATS_API_KEY=
